# Copy to .env.local and fill in. Never commit .env.local.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_BASE_URL=https://app.clio.com
CLIO_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
ANTHROPIC_API_KEY=

# Optional
TEXT_MODEL=claude-haiku-4-5-20251001
DOC_MODEL=claude-sonnet-5-5
EXTRACT_CONCURRENCY=4
PDF_PAGES_PER_CHUNK=40
# USD per million tokens, for the cost-per-case estimate. Fill from Anthropic's pricing page.
# MODEL_PRICES={"claude-haiku-4-5-20251001":{"in":0,"out":0},"claude-sonnet-5-5":{"in":0,"out":0}}

# Optional: use OpenRouter instead of Anthropic directly. Leave ANTHROPIC_API_KEY empty and use OpenRouter model IDs.
# If your shell already exports ANTHROPIC_BASE_URL, it overrides this file (Next does not override existing env vars).
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# TEXT_MODEL=anthropic/claude-haiku-4.5
# DOC_MODEL=anthropic/claude-sonnet-4.5
